# ===== BotNexus - configurações =====
# Rode "npm run setup" para criar o .env com um APP_SECRET aleatório.

PORT=3000
# Endereço público do site (use https://seudominio.com.br quando tiver domínio)
APP_URL=http://localhost:3000
# Chave secreta (o setup preenche). Protege os tokens dos bots. NUNCA compartilhe.
APP_SECRET=
# E-mail que vira administrador ao se cadastrar
ADMIN_EMAIL=
ALLOW_REGISTER=true
# Isolamento dos bots: auto | on | off
BOT_SANDBOX=auto
# Use true se estiver atrás de proxy/túnel (Cloudflare, Nginx)
TRUST_PROXY=false

# --- E-mail (SMTP). Se ficar vazio, os e-mails aparecem no console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BotNexus <nao-responda@seudominio.com.br>

# --- Pagamento: AbacatePay (Pix com QR Code dentro do painel) ---
# Crie uma chave em Integrar > API Keys, com as permissões TRANSPARENT:CREATE e TRANSPARENT:READ.
# Chave de teste começa com abc_dev_ (não cobra de verdade). Se ficar vazio, usa as outras opções.
ABACATEPAY_API_KEY=
# Texto secreto que você inventa; coloque o MESMO no webhook cadastrado no AbacatePay (opcional)
ABACATEPAY_WEBHOOK_SECRET=
# Qual usar se houver mais de uma configurada: abacatepay | mercadopago | manual (vazio = automático)
PAYMENT_PROVIDER=

# --- Mercado Pago. Se ficar vazio, usa Pix manual (você aprova no painel Admin) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PIX_MANUAL_KEY=
PIX_MANUAL_NAME=
